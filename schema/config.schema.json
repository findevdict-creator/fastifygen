{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/findevdict-creator/fastifygen/schema/config.schema.json",
  "title": "fastifygen configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "database"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "database": {
      "title": "Database",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "Postgres connection string. Use ${ENV_VAR} to keep secrets out of the file."
        },
        "host": {
          "type": "string",
          "description": "Server host, when not using url."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Server port (Postgres default: 5432)."
        },
        "user": {
          "type": "string",
          "description": "Database user."
        },
        "password": {
          "type": "string",
          "description": "Database password. Prefer ${DB_PASSWORD}."
        },
        "database": {
          "type": "string",
          "description": "Database name, when not using url."
        },
        "ssl": {
          "type": "boolean",
          "description": "Connect over TLS."
        },
        "schema": {
          "type": "string",
          "default": "public",
          "description": "Postgres schema to introspect."
        }
      },
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "host",
            "database"
          ]
        }
      ],
      "default": {}
    },
    "output": {
      "title": "Output",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "default": "./generated",
          "description": "Relative to config.json."
        },
        "mode": {
          "type": "string",
          "enum": [
            "development",
            "production"
          ],
          "default": "development",
          "description": "production leaves out files only used during development: the README, the dev token script and the dev scripts."
        }
      },
      "default": {}
    },
    "tables": {
      "title": "Tables",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*"
          ],
          "description": "Glob patterns of tables to include."
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "knex_migrations",
            "knex_migrations_lock"
          ],
          "description": "Glob patterns of tables to leave out. Wins over include."
        }
      },
      "default": {}
    },
    "api": {
      "title": "API",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "type": "string",
          "default": "/items",
          "pattern": "^/",
          "description": "URL prefix for every table, e.g. /items/company."
        },
        "defaultLimit": {
          "type": "integer",
          "minimum": 1,
          "default": 100,
          "description": "Items per page when the request sets no limit."
        },
        "maxLimit": {
          "type": "integer",
          "minimum": 1,
          "default": 1000,
          "description": "Largest page a request may ask for; limit=-1 means this."
        }
      },
      "default": {}
    },
    "tenancy": {
      "title": "Multitenancy",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Scope tables that have the tenant column to the caller's tenant."
        },
        "column": {
          "type": "string",
          "default": "tenant_id",
          "description": "Tables with this column are tenant-scoped."
        },
        "rls": {
          "type": "boolean",
          "default": true,
          "description": "Generate row-level security policies."
        },
        "settingName": {
          "type": "string",
          "default": "app.tenant_id",
          "pattern": "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$",
          "description": "Postgres setting the RLS policy reads."
        }
      },
      "default": {}
    },
    "auth": {
      "title": "Auth",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "jwt",
            "header",
            "none"
          ],
          "default": "jwt",
          "description": "jwt: verify a bearer token. header: trust headers set by a gateway. none: development only."
        },
        "tenantClaim": {
          "type": "string",
          "default": "tenant_id",
          "description": "Token claim (or header) holding the tenant id."
        },
        "permissionsClaim": {
          "type": "string",
          "default": "permissions",
          "description": "Token claim (or header) holding the permission list."
        }
      },
      "default": {}
    },
    "permissions": {
      "title": "Permissions",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "default": "{action}:{table}",
          "description": "Permission name template. {action} and {table} are replaced."
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "create",
              "read",
              "update",
              "delete"
            ]
          },
          "uniqueItems": true,
          "default": [
            "create",
            "read",
            "update",
            "delete"
          ],
          "description": "Actions that get routes and permissions. Read is always generated."
        }
      },
      "default": {}
    },
    "overrides": {
      "title": "Per-table overrides",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "skip": {
            "type": "boolean",
            "description": "Leave this table out."
          },
          "readOnly": {
            "type": "boolean",
            "description": "Only generate the GET routes."
          },
          "hiddenColumns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Never returned, filtered, sorted or searched; still writable."
          },
          "routeName": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "description": "URL segment instead of the table name."
          }
        }
      },
      "default": {}
    }
  }
}
