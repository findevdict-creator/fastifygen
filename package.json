{
  "name": "fastifygen",
  "version": "0.1.0",
  "description": "Generate a class-based Fastify REST API from a PostgreSQL schema",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./schema/config.schema.json": "./schema/config.schema.json"
  },
  "bin": {
    "fastifygen": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "src/runtime"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "vitest run",
    "schema:write": "tsx scripts/write-config-schema.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "fastify": "^5.12.7",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "qs": "^6.16.1"
  },
  "devDependencies": {
    "@fastify/jwt": "^10.2.5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
